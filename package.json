{
  "name": "verity-quality-checks",
  "private": true,
  "scripts": {
    "test": "node --test tests/frontend.test.cjs tests/statistics.test.cjs tests/locale.test.cjs tests/study.test.cjs tests/completion.test.cjs",
    "lint": "eslint static/*.js && prettier --check static/*.js static/*.css",
    "format": "prettier --write static/*.js static/*.css",
    "calendar": "node scripts/build_calendar_data.cjs --check",
    "test:browser": "node scripts/browser_check.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "eslint": "10.14.0",
    "globals": "16.5.0",
    "playwright": "1.64.1",
    "prettier": "3.6.2"
  }
}
